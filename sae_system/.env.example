# 127.0.0.1, not 'localhost': on Windows 'localhost' resolves to ::1 first, Ollama listens on IPv4 only,
# and every new connection then waits ~2 s before falling back (measured: 2050 ms vs 5 ms).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
DATABASE_URL=postgresql://sae_user:sae_password@localhost:5432/sae_db
REDIS_URL=redis://localhost:6379/0
# Neo4j (optional) — the supported setup is the local Docker container from docker-compose.yml:
#   docker compose up -d neo4j
# The user/password below match that container's NEO4J_AUTH (neo4j/saesystem), so no changes are
# needed. Leave USE_NEO4J=false (the default) to use the built-in local graph with no database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=saesystem
USE_NEO4J=false
COMPLEXITY_THRESHOLD=0.75
# Evidence-based default (see config.py / SAE_ARCHITECTURE_AUDIT.md) — do not
# lower this back toward 0.45 without re-running evaluation/grading_evaluator.py.
SEMANTIC_PASS_THRESHOLD=0.60
# Kept below SEMANTIC_PASS_THRESHOLD so the auditor's clarification band isn't zero-width.
SEMANTIC_DIALOGUE_THRESHOLD=0.45
LOGIC_GATE_THRESHOLD=0.65

# Friends/chat only — a small networked service, separate from the AI stack.
# See social_server/README.md. Never used for lessons, tests, or progress.
SOCIAL_SERVER_URL=http://localhost:8000
