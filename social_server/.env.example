# Social server settings. Copy this file to social_server/.env (it is git-ignored).
#
# Docker Compose reads this automatically and uses it for BOTH the database password and the API's
# connection URL, so there is a single secret to set. Generate one with: openssl rand -hex 24
SOCIAL_DB_PASSWORD=change-me-generate-a-long-random-password

# Only if you run the API on the host (e.g. `uvicorn app.main:app`) instead of in Docker: the app reads
# SOCIAL_DATABASE_URL straight from the process environment and does NOT load this file, so export it:
#   export SOCIAL_DATABASE_URL="postgresql://sae_social_user:${SOCIAL_DB_PASSWORD}@localhost:5433/sae_social"
